# Analytics is fully optional — leave these unset and no tracking script is
# ever injected (dev, build and tests all work with zero config).
#
# Pick ONE provider and fill in the matching site id. Both are privacy-
# friendly (no cookies, no personal data) and work self-hosted or cloud.
#
# Umami (self-hosted or cloud.umami.is):
#   VITE_ANALYTICS_PROVIDER=umami
#   VITE_ANALYTICS_SCRIPT_URL=https://your-umami-instance.example.com/script.js
#   VITE_ANALYTICS_SITE_ID=your-website-id
#
# Plausible (self-hosted or plausible.io):
#   VITE_ANALYTICS_PROVIDER=plausible
#   VITE_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
#   VITE_ANALYTICS_SITE_ID=yourdomain.com

VITE_ANALYTICS_PROVIDER=
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_SITE_ID=
